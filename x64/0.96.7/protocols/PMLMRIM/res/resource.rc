 LTEXT "Port:",IDC_STATIC,5,65,58,10
 EDITTEXT IDC_PORT,66,63,50,13,ES_AUTOHSCROLL | ES_NUMBER
 LTEXT "Avatar server:",IDC_STATIC,5,87,58,10
 EDITTEXT IDC_AVATAR_SERVER,66,85,118,13,ES_AUTOHSCROLL
