 LTEXT "Avatar port:",IDC_STATIC,5,108,58,10
 EDITTEXT IDC_AVATAR_PORT,66,106,50,13,ES_AUTOHSCROLL | ES_NUMBER
 LTEXT "Message encoding:",IDC_STATIC,5,129,72,10
 COMBOBOX IDC_MESSAGE_ENCODING,80,126,104,95,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END
IDD_OPTIONS DIALOGEX 0,0,190,158
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8,"MS Shell Dlg"
BEGIN
